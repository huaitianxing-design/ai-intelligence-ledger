# Copy to .env and set real values locally; never commit .env.
LEDGER_DB_HOST=127.0.0.1
LEDGER_DB_PORT=5432
LEDGER_DB_NAME=ledger
LEDGER_DB_USER=ledger_user
LEDGER_DB_PASSWORD=replace-with-a-strong-secret

# Generate a long random secret and share only with the trusted auth proxy.
LEDGER_IDENTITY_HMAC_SECRET=replace-with-a-long-random-secret
# Comma-separated front-end origins; leave empty for same-origin deployments.
LEDGER_CORS_ORIGINS=http://localhost:8000

# Anthropic Messages API (or compatible endpoint/model).
LEDGER_LLM_BASE_URL=https://api.anthropic.com
LEDGER_LLM_MODEL=replace-with-supported-model-id
ANTHROPIC_API_KEY=replace-with-api-key
